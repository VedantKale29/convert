# Copy to .env (never commit .env)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Governance: set to true only after confirming the data classification allows an external LLM.
# Until then, use mock screens with dummy data only.
ALLOW_EXTERNAL_LLM=false

# ---- HTTP API service (service/api.py) ----
# Comma-separated keys accepted in the X-API-Key header (give the Node BFF its own long random key)
UIGEN_API_KEYS=
UIGEN_PROVIDER=openai          # "demo" = scripted replies for integration testing
UIGEN_WORKERS=2                # generations running at once per API instance
UIGEN_MAX_PENDING=20           # queued beyond that; more -> HTTP 429
UIGEN_EXPOSE_DOCS=false        # /docs and /openapi.json (keep off in production)
RUNS_RETENTION_DAYS=7          # generation folders (contain screenshots) are deleted after this
# UIGEN_RUNS_DIR=  UIGEN_CACHE_DIR=  UIGEN_TRACE_DIR=   (default: inside the project)
# OPENAI_TIMEOUT_S=90  OPENAI_MAX_RETRIES=2
